# Delima Realtors Platform 2.0 — environment template
# Copy to .env and adjust:  cp .env.example .env

# SQLite database file used by Prisma (relative to the project root).
DATABASE_URL=file:./db/custom.db

# Passcode required in the `x-admin-key` header for CRM endpoints
# (GET/PATCH /api/leads). Unset falls back to the demo passcode `delima2026`
# — change it for any deployment that is reachable by others.
# ADMIN_PASSCODE=change-me-demo-default-delima2026

# Set to 1 to disable API rate limiting (useful for tests/CI). Leave unset in
# normal operation — limits: subscribe 5/min, leads 10/min, assistant 15/5min, valuation 10/5min per IP.
# RATE_LIMIT_DISABLED=0

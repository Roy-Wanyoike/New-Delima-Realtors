# Delima Realtors Platform 2.0 — environment template
# Copy to .env and adjust:  cp .env.example .env

# SQLite database file used by Prisma (relative to the project root).
DATABASE_URL=file:./db/custom.db

# Passcode required in the `x-admin-key` header for CRM endpoints
# (GET/PATCH /api/leads). Unset falls back to the demo passcode `delima2026`
# — change it for any deployment that is reachable by others.
# ADMIN_PASSCODE=change-me-demo-default-delima2026

# Set to 1 to disable API rate limiting (useful for tests/CI). Leave unset in
# normal operation — limits: subscribe 5/min, leads 10/min, assistant 15/5min, valuation 10/5min per IP.
# RATE_LIMIT_DISABLED=0

# ─────────────────────────────────────────────────────────────────────────────
# PRODUCTION (Vercel + Supabase Postgres) — set DATABASE_URL in Vercel env vars
# ─────────────────────────────────────────────────────────────────────────────
# The deployed app uses the Postgres schema (prisma/schema.postgres.prisma).
# Get both strings from Supabase → Project Settings → Database → Connection string.
#
# RUNTIME (Vercel serverless): "Transaction" pooler, port 6543, pgbouncer on:
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# ONE-TIME PROVISIONING (run locally before first deploy): "Session" pooler, port 5432:
#   DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#   npm run db:pg:push && npm run db:pg:seed
#
# CRM passcode for /api/leads (x-admin-key header) — REQUIRED in production:
#   ADMIN_PASSCODE=<a long private string>
#
# Full runbook: DEPLOYMENT.md

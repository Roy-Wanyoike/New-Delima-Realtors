# ---- Supabase ----
# Public anon key (safe to expose to the browser; RLS must enforce access control).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# ---- Admin ----
# NOTE: Do NOT put the admin password in an env var shipped to the browser.
# Admin authentication must be handled server-side via Supabase Auth (see SECURITY.md).
# VITE_ADMIN_PASSWORD is intentionally absent from this example.

# ---- Vercel / Supabase publishable key (if using Vercel + Supabase publishable key flow) ----
PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY
